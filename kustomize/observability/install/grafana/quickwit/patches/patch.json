[
  {
    "op": "add",
    "path": "/spec/values/datasources/datasources.yaml/datasources/-",
    "value": {
      "name": "Quickwit Logs",
      "uid": "quickwit-logs",
      "type": "quickwit-quickwit-datasource",
      "url": "http://quickwit-searcher.system-observability.svc.cluster.local:7280/api/v1",
      "jsonData": {
        "index": "otel-logs-v0_9",
        "logLevelField": "severity_text",
        "logMessageField": "body.message"
      }
    }
  },
  {
    "op": "add",
    "path": "/spec/values/extraVolumeMounts/-",
    "value": {
      "name": "plugins",
      "mountPath": "/var/lib/grafana/plugins/quickwit-quickwit-datasource",
      "subPath": "quickwit-quickwit-datasource",
      "readOnly": true
    }
  }
]
